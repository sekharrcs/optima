OPTIMA_SEMANTIC_CACHE_ENABLED=true
OPTIMA_CONTEXT_REDUCTION_ENABLED=true
OPTIMA_HISTORICAL_POLICY_ENABLED=true
OPTIMA_FOUNDRY_ROUTER_COMPARATOR_ENABLED=false
OPTIMA_STANDARD_QUALITY_THRESHOLD=0.80
OPTIMA_HIGH_QUALITY_THRESHOLD=0.90
OPTIMA_CRITICAL_QUALITY_THRESHOLD=0.95
OPTIMA_CACHE_SIMILARITY_THRESHOLD=0.95
OPTIMA_CONTEXT_REDUCTION_CONSIDER_TOKENS=4000
OPTIMA_CONTEXT_REDUCTION_REQUIRED_TOKENS=8000
OPTIMA_HISTORY_MINIMUM_SAMPLES=20
OPTIMA_HISTORY_SMALL_PREFER_PASS_RATE=0.95
OPTIMA_HISTORY_SMALL_AVOID_PASS_RATE=0.70

# Optional Foundry/APIM provider composition. Choose exactly one auth mode.
# OPTIMA_FOUNDRY_BASE_URL=https://gateway.example/openai/v1
# OPTIMA_FOUNDRY_SMALL_DEPLOYMENT=small-deployment
# OPTIMA_FOUNDRY_STRONG_DEPLOYMENT=strong-deployment
# OPTIMA_FOUNDRY_AUTH_MODE=API_KEY
# OPTIMA_FOUNDRY_API_KEY=
# OPTIMA_FOUNDRY_TOKEN_SCOPE=api://optima-apim/.default
# OPTIMA_FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=
# OPTIMA_FOUNDRY_TIMEOUT_SECONDS=30
